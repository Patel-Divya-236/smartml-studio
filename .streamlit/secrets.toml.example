# Copy to .streamlit/secrets.toml and fill in. secrets.toml is gitignored.
#
# Any OpenAI-compatible provider works. Free tiers serving open-weight models
# include Groq, OpenRouter, Together AI, Hugging Face and Cerebras — check each
# provider's current terms and model list before choosing.
#
# Without these the app runs exactly as before, with static explanations.

LLM_API_KEY = "your-provider-api-key"

# Defaults live in config/settings.py; uncomment to override.
# LLM_BASE_URL = "https://api.groq.com/openai/v1"
# LLM_MODEL    = "openai/gpt-oss-120b"
