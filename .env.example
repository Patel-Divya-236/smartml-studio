# Copy to .env on the host before `docker compose up -d`. Never commit the filled-in copy.

# Hostname Caddy serves the API on. Its DNS A record must already point at this machine.
API_DOMAIN=smartml-api.example.com

# The frontend's origin(s), comma-separated. This project's *.vercel.app previews are
# already matched by pattern in backend/main.py; list the production alias and any custom
# domain here.
SMARTML_ALLOWED_ORIGINS=https://smartml-studio.vercel.app

# LLM narration. Without a key the app still works — explanations fall back to the
# deterministic text the advisors already produce.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check the provider still serves this id: python scripts_list_models.py
LLM_MODEL=openai/gpt-oss-120b
