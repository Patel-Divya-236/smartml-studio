# Copy to .env on the host before `docker compose up -d`. Never commit the filled-in copy.

# Hostname Caddy serves the API on. Its DNS A record must point at this machine.
API_DOMAIN=smartml-api.example.com

# Optional: a free DuckDNS hostname that follows this machine's IP. Needed when the
# instance is stopped and started (its public IP changes each time) and has no Elastic IP.
# Create the subdomain at https://www.duckdns.org, then set API_DOMAIN above to
# <subdomain>.duckdns.org. Leave both empty when the IP is fixed or the domain is your own.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# The frontend's origin(s), comma-separated. This project's *.vercel.app previews are
# already matched by pattern in backend/main.py; list the production alias and any custom
# domain here.
SMARTML_ALLOWED_ORIGINS=https://smartml-studio.vercel.app

# The LLM plans the preprocessing, feature-engineering and model recommendations and
# writes the plain-English explanations. Without a key the app still works: the rule-based
# advisors recommend instead, and explanations fall back to their own text.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check the provider still serves this id: python scripts_list_models.py
LLM_MODEL=openai/gpt-oss-120b

# Sized for a 2GB / 2 vCPU machine. Keep the budget below the container memory limit in
# docker-compose.yml (1400M); raise both together on a bigger instance.
SMARTML_MEMORY_BUDGET_MB=1300
SMARTML_TRAINING_THREADS=2
